DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/routerpoc

# Required to actually start a call — needs Realtime API access.
OPENAI_API_KEY=

OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=alloy

# STUN only, by design — no TURN. See plan.md.
STUN_URL=stun:stun.l.google.com:19302

CORS_ORIGINS=["*"]
