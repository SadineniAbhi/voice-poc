project_id           = "your-gcp-project-id"
domain_name          = "your.domain.com"
letsencrypt_email    = "you@example.com"
ssh_username         = "yourname"
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
github_repo_url      = "https://github.com/you/your-repo.git"

